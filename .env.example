# LedgerMind — environment template
# Copy to .env and fill in. Values below are placeholders except where noted.
#
#   cp .env.example .env
#
# The compose defaults for POSTGRES_PASSWORD / DATABASE_URL are the real local
# dev values (they already appear in docker-compose.yml) and work as-is.

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
# Gemini is primary, Groq is the failover. Both are free-tier.
# GEMINI_MODEL is asserted against the model the API reports at eval time --
# a score is meaningless without a stated model, so this must be accurate.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Cohere Rerank is the PRIMARY reranker. If unset, retrieval falls back to the
# local ONNX cross-encoder -- which works, but returns raw logits on a different
# scale, so confidence thresholds switch with it. See docs/IMPLEMENTATION_DELTAS.md.
COHERE_API_KEY=your-cohere-api-key

# ---------------------------------------------------------------------------
# Vector store
# ---------------------------------------------------------------------------
# Local dev: http://qdrant:6333 (the compose service).
# Cloud: your cluster URL + API key.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ---------------------------------------------------------------------------
# Relational store
# ---------------------------------------------------------------------------
# Local dev values below match docker-compose.yml and need no change.
POSTGRES_PASSWORD=app_dev_pass
DATABASE_URL=postgresql://ledgermind_app:app_dev_pass@postgres:5432/ledgermind

# ADMIN_DATABASE_URL bypasses row-level security. Used by migrations and
# maintenance scripts only -- never by the request path.
ADMIN_DATABASE_URL=postgresql://ledgermind:CHANGE_ME@postgres:5432/ledgermind

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=generate-a-random-32-byte-hex-string
ADMIN_EMAIL=admin@yourdomain.test

# ---------------------------------------------------------------------------
# Deployment (not needed for local docker compose)
# ---------------------------------------------------------------------------
HOST=0.0.0.0
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-key
